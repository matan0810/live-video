// Cloudflare Worker behind the site: remote channel list, viewer reports and admin API. See README.md for setup.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "live-video-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Browser Run's client library needs the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  // A real browser for the link finder (Cloudflare Browser Run (formerly Browser Rendering); the free plan allows
  // 10 minutes a day). Deploying needs the API token's "Browser Run: Edit" permission.
  "browser": { "binding": "BROWSER" },
  // Keeps the Worker's own log lines (Workers Logs, free) so failures can be diagnosed.
  // Cloudflare's automatic per-request log is off: it would store request headers. The
  // Worker logs one line per request itself, without addresses, tokens or bodies.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      // Filled in at deploy time by scripts/ensure-kv.mjs; leave the placeholder here.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://matan0810.github.io,http://localhost:5173",
  },
  // ADMIN_PASSWORD is a secret, set by the Deploy Worker workflow from a GitHub secret.
}

// Cloudflare Worker behind the site: remote channel list, viewer reports, admin API
// and fresh addresses for token-protected streams. See README.md for setup.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "live-video-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    {
      "binding": "KV",
      // Filled in at deploy time by scripts/ensure-kv.mjs; leave the placeholder here.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://matan0810.github.io,http://localhost:5173",
  },
  // ADMIN_PASSWORD is a secret, set by the Deploy Worker workflow from a GitHub secret.
}
